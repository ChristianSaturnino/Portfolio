# Copy to .env (already in .gitignore) and fill in. On Vercel, set the same names
# under Project Settings > Environment Variables.

# Gemini key from https://aistudio.google.com/api-keys (free tier, no billing)
GEMINI_API_KEY=

# Private notes for the assistant, generated from private/assistant-profile.md
# by `npm run assistant:profile` (paste the printed value on Vercel too)
ASSISTANT_PROFILE=

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_DAILY_CAP=400
# local only: canned replies, no Gemini call
ASSISTANT_MOCK=false
