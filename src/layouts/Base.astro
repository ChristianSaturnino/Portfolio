---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { site, type Lang } from "../data/site";
import { useTranslations } from "../i18n/ui";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? `${site.name} · ${site.role[lang]}`;
const pageDesc = description ?? site.tagline[lang];
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// 1200x630 card shown when the link is shared (one per language)
const ogImage = new URL(`/img/og-${lang}.png`, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#0f0e0c" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.role[lang]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" hreflang="pt-BR" href={new URL("/", Astro.site ?? Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL("/en", Astro.site ?? Astro.url).href} />
  </head>
  <body>
    <a href="#feed" class="skip-link">{t("skip")}</a>
    <slot />
    <WhatsAppButton lang={lang} />

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--accent);
        color: var(--on-accent);
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.85rem;
        transition: top 0.2s ease;
        z-index: 100;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>

    <script>
      // feed filter tabs: shown only when JS runs, so no-JS visitors get the full feed
      const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
      const posts = [...document.querySelectorAll<HTMLElement>("[data-tabs]")];
      document.querySelector("[data-tablist]")?.removeAttribute("hidden");

      const select = (tab: string) => {
        tabs.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tab === tab)));
        posts.forEach((p) => {
          p.hidden = tab !== "all" && !p.dataset.tabs!.split(" ").includes(tab);
        });
      };
      tabs.forEach((b) =>
        b.addEventListener("click", () => {
          select(b.dataset.tab!);
          const top = document.getElementById("timeline");
          if (top && top.getBoundingClientRect().top < 0) top.scrollIntoView({ block: "start" });
        })
      );

      // copy a post's permalink
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
        b.addEventListener("click", async () => {
          const url = `${location.origin}${location.pathname}#${b.dataset.copy}`;
          try {
            await navigator.clipboard.writeText(url);
          } catch {
            location.hash = b.dataset.copy!;
            return;
          }
          b.dataset.done = "";
          const label = b.querySelector("[data-label]");
          const prev = label?.textContent;
          if (label) label.textContent = b.dataset.doneLabel ?? "";
          setTimeout(() => {
            delete b.dataset.done;
            if (label) label.textContent = prev ?? "";
          }, 1800);
        });
      });
    </script>
  </body>
</html>
