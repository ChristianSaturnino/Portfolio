---
import type { Lang } from "../data/site";
import { site } from "../data/site";
import { useTranslations } from "../i18n/ui";

// Waving pixel-art me next to the hero. Clicking it opens a modal chat with the
// AI assistant (src/pages/api/chat.ts). The conversation survives closing the
// modal (and page changes, via sessionStorage) until "clear chat".
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const strings = {
  greeting: t("assistant.greeting"),
  thinking: t("assistant.thinking"),
  error: t("assistant.error"),
  suggestions: t("assistant.suggestions").split("|"),
};
const linkHosts = ["christiansaturnino.com.br", "www.christiansaturnino.com.br", "wa.me", "linkedin.com", "www.linkedin.com", "github.com"];
---

<div class="asst" data-lang={lang} data-strings={JSON.stringify(strings)} data-hosts={JSON.stringify(linkHosts)} data-email={site.email}>
  <button type="button" class="launcher" data-open aria-haspopup="dialog" aria-label={t("assistant.open")}>
    <span class="bubble">{t("assistant.bubble")}</span>
    <span class="me" aria-hidden="true">
      <img class="l-body" src="/img/assistant/body.webp" alt="" width="585" height="590" />
      <img class="l-arm" src="/img/assistant/arm.webp" alt="" width="585" height="590" />
      <img class="l-spark" src="/img/assistant/spark.webp" alt="" width="585" height="590" />
    </span>
  </button>

  <dialog class="asst-dialog" aria-labelledby="asst-title">
    <div class="asst-panel">
      <header class="asst-head">
        <span class="asst-avatar" aria-hidden="true"><img src="/img/assistant/avatar.webp" alt="" width="128" height="128" /></span>
        <div class="asst-name">
          <h2 id="asst-title">{t("assistant.title")}</h2>
          <p><span class="asst-dot"></span>{t("assistant.subtitle")}</p>
        </div>
        <button type="button" class="asst-icon asst-clear" data-clear title={t("assistant.clear")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" /></svg>
          <span>{t("assistant.clear")}</span>
        </button>
        <button type="button" class="asst-icon" data-close aria-label={t("assistant.close")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>

      <div class="asst-log" data-log role="log" aria-live="polite"></div>

      <form class="asst-form" data-form>
        <textarea data-input rows="1" maxlength="500" placeholder={t("assistant.placeholder")} aria-label={t("assistant.placeholder")}></textarea>
        <button type="submit" class="asst-send" aria-label={t("assistant.send")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </button>
      </form>
      <p class="asst-note">{t("assistant.disclaimer")}</p>
    </div>
  </dialog>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string; note?: boolean };
  const KEY = "asst:v1";

  for (const root of document.querySelectorAll<HTMLElement>(".asst")) {
    const lang = root.dataset.lang as "pt" | "en";
    const s = JSON.parse(root.dataset.strings!) as { greeting: string; thinking: string; error: string; suggestions: string[] };
    const hosts = new Set<string>(JSON.parse(root.dataset.hosts!));
    const email = root.dataset.email!;
    const dialog = root.querySelector<HTMLDialogElement>("dialog")!;
    const log = root.querySelector<HTMLElement>("[data-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    let busy = false;

    const load = (): Msg[] => {
      try {
        const v = JSON.parse(sessionStorage.getItem(KEY) ?? "[]");
        return Array.isArray(v) ? v.filter((m) => m && typeof m.content === "string").slice(-40) : [];
      } catch {
        return [];
      }
    };
    let messages: Msg[] = load();
    const save = () => {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(messages));
      } catch {}
    };

    // tiny, safe renderer: text nodes only, **bold**, "- " lists, allow-listed links
    const linkify = (parent: HTMLElement, text: string) => {
      const re = /\[([^\]\n]{1,80})\]\((https?:\/\/[^\s)]+|mailto:[^\s)]+)\)|(https?:\/\/[^\s<>()]+)|([\w.+-]+@[\w-]+(?:\.[\w-]+)+)|\*\*([^*]+)\*\*/g;
      let last = 0;
      for (const m of text.matchAll(re)) {
        parent.append(text.slice(last, m.index));
        last = m.index! + m[0].length;
        if (m[5]) {
          const b = document.createElement("strong");
          b.textContent = m[5];
          parent.append(b);
          continue;
        }
        if (m[1]) {
          // [label](url): a link only when the url is allow-listed, else just the label
          let href: string | null = null;
          try {
            const u = new URL(m[2]);
            if (u.protocol === "mailto:") href = u.pathname.toLowerCase() === email.toLowerCase() ? `mailto:${email}` : null;
            else if (u.protocol === "https:" && hosts.has(u.host)) href = u.href;
          } catch {}
          if (href) {
            const a = document.createElement("a");
            a.href = href;
            a.textContent = m[1];
            if (!href.startsWith("mailto:")) {
              a.target = "_blank";
              a.rel = "noopener";
            }
            parent.append(a);
          } else parent.append(m[1]);
          continue;
        }
        let raw = m[3] ?? m[4];
        const tail = raw.match(/[.,;:!?]+$/)?.[0] ?? "";
        raw = raw.slice(0, raw.length - tail.length);
        let href: string | null = null;
        if (m[4]) href = raw.toLowerCase() === email.toLowerCase() ? `mailto:${raw}` : null;
        else {
          try {
            const u = new URL(raw);
            if (u.protocol === "https:" && hosts.has(u.host)) href = u.href;
          } catch {}
        }
        if (href) {
          const a = document.createElement("a");
          a.href = href;
          a.textContent = raw.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
          if (!href.startsWith("mailto:")) {
            a.target = "_blank";
            a.rel = "noopener";
          }
          parent.append(a);
        } else parent.append(raw);
        parent.append(tail);
      }
      parent.append(text.slice(last));
    };
    const renderText = (el: HTMLElement, text: string) => {
      let list: HTMLUListElement | null = null;
      let para: HTMLParagraphElement | null = null;
      for (const line of text.split("\n")) {
        const item = line.match(/^\s*[-*•]\s+(.*)/);
        if (item) {
          para = null;
          list ??= el.appendChild(document.createElement("ul"));
          linkify(list.appendChild(document.createElement("li")), item[1]);
        } else if (line.trim()) {
          list = null;
          if (para) para.append(document.createElement("br"));
          else para = el.appendChild(document.createElement("p"));
          linkify(para, line.replace(/^#+\s*/, ""));
        } else {
          list = null;
          para = null;
        }
      }
    };

    const bubble = (m: Msg) => {
      const el = document.createElement("div");
      el.className = `asst-msg ${m.role === "user" ? "is-user" : "is-bot"}${m.note ? " is-note" : ""}`;
      if (m.role === "user") el.textContent = m.content;
      else renderText(el, m.content);
      return el;
    };

    const render = () => {
      log.replaceChildren(bubble({ role: "assistant", content: s.greeting }));
      for (const m of messages) log.append(bubble(m));
      if (messages.length === 0) {
        const chips = document.createElement("div");
        chips.className = "asst-chips";
        for (const q of s.suggestions) {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = q;
          b.addEventListener("click", () => send(q));
          chips.append(b);
        }
        log.append(chips);
      }
      log.scrollTop = log.scrollHeight;
    };

    const send = async (text: string) => {
      text = text.trim().slice(0, 500);
      if (!text || busy) return;
      busy = true;
      form.classList.add("is-busy");
      messages.push({ role: "user", content: text });
      save();
      render();
      const dots = document.createElement("div");
      dots.className = "asst-msg is-bot is-typing";
      dots.setAttribute("aria-label", s.thinking);
      dots.innerHTML = "<i></i><i></i><i></i>";
      log.append(dots);
      log.scrollTop = log.scrollHeight;

      let reply = s.error;
      let ok = false;
      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ lang, messages: messages.filter((m) => !m.note).map(({ role, content }) => ({ role, content })) }),
        });
        const data = await res.json().catch(() => ({}));
        if (typeof data.reply === "string" && data.reply) reply = data.reply;
        ok = res.ok;
      } catch {}
      messages.push({ role: "assistant", content: reply, ...(ok ? {} : { note: true }) });
      save();
      busy = false;
      form.classList.remove("is-busy");
      render();
      input.focus();
    };

    root.querySelector("[data-open]")!.addEventListener("click", () => {
      render();
      dialog.showModal();
      document.documentElement.classList.add("asst-lock");
      input.focus();
    });
    dialog.addEventListener("close", () => document.documentElement.classList.remove("asst-lock"));
    root.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
    // click on the dimmed backdrop closes it
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    root.querySelector("[data-clear]")!.addEventListener("click", () => {
      if (busy) return;
      messages = [];
      save();
      render();
      input.focus();
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = input.value;
      input.value = "";
      input.style.height = "";
      send(v);
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    input.addEventListener("input", () => {
      input.style.height = "";
      input.style.height = `${Math.min(input.scrollHeight, 140)}px`;
    });
  }
</script>

<style>
  /* ---------- launcher (waving me) ---------- */
  .launcher {
    position: relative;
    display: block;
    width: clamp(12rem, 22vw, 17rem);
    padding: 0;
    border-radius: var(--radius);
    -webkit-tap-highlight-color: transparent;
  }
  .launcher:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .me {
    position: relative;
    display: block;
    aspect-ratio: 585 / 590;
    animation: bob 1.6s steps(2, jump-none) infinite;
    transition: transform 0.25s var(--ease);
  }
  .launcher:hover .me {
    transform: scale(1.04) rotate(-1.5deg);
  }
  .me img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* pivot = the shoulder, measured on the sprite */
  .l-arm {
    transform-origin: 64.1% 42.8%;
    animation: wave 3.4s var(--ease) infinite;
  }
  .l-spark {
    animation: spark 3.4s steps(1, end) infinite;
  }
  .bubble {
    position: absolute;
    z-index: 1;
    right: 30%;
    bottom: calc(100% - 0.4rem);
    width: max-content;
    max-width: 13.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 14px 14px 4px 14px;
    background: var(--card);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: left;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.7);
    animation: pop 3.4s var(--ease) infinite;
  }
  .bubble::after {
    content: "";
    position: absolute;
    right: 14px;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: var(--card);
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transform: rotate(45deg);
  }
  .launcher:hover .bubble {
    border-color: var(--accent);
  }
  .launcher:hover .bubble::after {
    border-color: var(--accent);
  }
  @keyframes wave {
    0%, 62%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(-13deg); }
    22% { transform: rotate(7deg); }
    34% { transform: rotate(-13deg); }
    46% { transform: rotate(7deg); }
  }
  @keyframes spark {
    0%, 8%, 24%, 40%, 62%, 100% { opacity: 1; }
    12%, 28%, 44% { opacity: 0; }
  }
  @keyframes bob {
    to { transform: translateY(-3px); }
  }
  @keyframes pop {
    0%, 100% { transform: translateY(0); }
    10% { transform: translateY(-3px); }
    20% { transform: translateY(0); }
  }
  @media (max-width: 860px) {
    .launcher {
      width: 9.5rem;
    }
    /* phones: bubble sits to the left of the figure, saving height */
    .bubble {
      right: calc(100% - 1rem);
      bottom: 48%;
      max-width: 11rem;
      font-size: 0.82rem;
    }
    .bubble::after {
      right: -7px;
      bottom: 12px;
      border-bottom: 0;
      border-top: 1px solid var(--line-strong);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .me, .l-arm, .l-spark, .bubble {
      animation: none;
    }
  }
</style>

<style is:global>
  /* the dialog content is built at runtime, so these rules are global (prefixed asst-) */
  html.asst-lock {
    overflow: hidden;
  }
  .asst-dialog {
    margin: auto;
    width: min(32rem, calc(100% - 2rem));
    height: min(44rem, calc(100% - 2rem));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }
  .asst-dialog::backdrop {
    background: rgb(8 7 6 / 0.7);
    backdrop-filter: blur(4px);
  }
  .asst-dialog[open] {
    animation: asst-in 0.25s var(--ease);
  }
  @keyframes asst-in {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
  }
  .asst-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .asst-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0.9rem 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .asst-avatar {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--accent-soft);
    overflow: hidden;
  }
  .asst-avatar img {
    width: 100%;
    height: 100%;
    transform: translateY(8%);
  }
  .asst-name {
    flex: 1;
    min-width: 0;
  }
  .asst-name h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .asst-name p {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-3);
    font-size: 0.8rem;
  }
  .asst-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }
  .asst-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.3rem;
    min-width: 2.3rem;
    justify-content: center;
    padding: 0 0.6rem;
    border-radius: 10px;
    color: var(--ink-2);
    font-size: 0.82rem;
  }
  .asst-icon:hover {
    background: var(--sunk);
    color: var(--ink);
  }
  .asst-icon svg,
  .asst-send svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .asst-log {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
  }
  .asst-msg {
    max-width: 86%;
    padding: 0.65rem 0.85rem;
    border-radius: 14px;
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .asst-msg.is-user {
    align-self: flex-end;
    background: var(--accent);
    color: var(--on-accent);
    border-bottom-right-radius: 4px;
    white-space: pre-wrap;
  }
  .asst-msg.is-bot {
    align-self: flex-start;
    background: var(--sunk);
    border-bottom-left-radius: 4px;
  }
  .asst-msg.is-note {
    color: var(--ink-2);
    border: 1px dashed var(--line-strong);
    background: transparent;
  }
  .asst-msg p + p,
  .asst-msg p + ul,
  .asst-msg ul + p {
    margin-top: 0.5rem;
  }
  .asst-msg ul {
    padding-left: 1.1rem;
    list-style: disc;
  }
  .asst-msg li + li {
    margin-top: 0.2rem;
  }
  .asst-msg a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .asst-msg strong {
    font-weight: 700;
    color: var(--ink);
  }
  .asst-msg.is-typing {
    display: flex;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
  }
  .asst-msg.is-typing i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink-3);
    animation: asst-dots 1s infinite ease-in-out;
  }
  .asst-msg.is-typing i:nth-child(2) { animation-delay: 0.15s; }
  .asst-msg.is-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes asst-dots {
    0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }
  .asst-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.2rem;
  }
  .asst-chips button {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.85rem;
    text-align: left;
  }
  .asst-chips button:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
  .asst-form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin: 0 1rem;
    padding: 0.4rem 0.4rem 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--bg);
  }
  .asst-form:focus-within {
    border-color: var(--accent);
  }
  .asst-form textarea {
    flex: 1;
    min-height: 2.4rem;
    padding: 0.55rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.35;
    resize: none;
    outline: none;
  }
  .asst-send {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .asst-form.is-busy .asst-send {
    opacity: 0.5;
    pointer-events: none;
  }
  .asst-note {
    padding: 0.6rem 1rem 0.9rem;
    color: var(--ink-3);
    font-size: 0.72rem;
    line-height: 1.4;
  }
  @media (max-width: 560px) {
    .asst-dialog {
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 0;
    }
    .asst-clear span {
      display: none;
    }
  }
</style>
