---
import { site, type Lang } from "../data/site";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">04.</span>
      <h2>{t("section.contact")}</h2>
      <span class="rule"></span>
    </div>

    <p class="prose reveal">{t("contact.body")}</p>

    <div class="channels reveal" data-delay="1">
      <a class="channel" href={`mailto:${site.email}`}>
        <span class="channel-label mono">e-mail</span>
        <span class="channel-value link-underline">{site.email}</span>
      </a>
      <a class="channel" href={site.socials.linkedin} target="_blank" rel="noopener">
        <span class="channel-label mono">linkedin</span>
        <span class="channel-value link-underline">in/christian-saturnino ↗</span>
      </a>
      <a class="channel" href={site.socials.github} target="_blank" rel="noopener">
        <span class="channel-label mono">github</span>
        <span class="channel-value link-underline">@ChristianSaturnino ↗</span>
      </a>
    </div>
  </div>

  <footer class="container">
    <span class="mono">© {year} {site.fullName}</span>
    <span class="mono">{t("footer.built")}</span>
  </footer>
</section>

<style>
  .channels {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 2.5rem;
    max-width: var(--maxw-text);
  }
  .channel {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-elev);
    transition: background 0.18s ease;
  }
  .channel:hover {
    background: var(--bg-elev-2);
  }
  .channel-label {
    flex: none;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-mute);
    min-width: 5.5rem;
  }
  .channel-value {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 460px) {
    .channel {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-mute);
  }
</style>
