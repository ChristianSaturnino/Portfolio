---
import type { Lang } from "../data/site";
import { skillGroups } from "../data/skills";
import { education, certifications, languages as langList } from "../data/experience";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const tr = (v: string | { pt: string; en: string }) => (typeof v === "string" ? v : v[lang]);
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">03.</span>
      <h2>{t("section.skills")}</h2>
      <span class="rule"></span>
    </div>

    <div class="skills">
      {skillGroups.map((g, i) => (
        <div class="group reveal" data-delay={String(Math.min(i, 3))}>
          <p class="group-label mono">{g.label[lang]}</p>
          <div class="tag-row">
            {g.items.map((s) => <span class="tag">{typeof s === "string" ? s : s[lang]}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="meta-grid reveal">
      <div>
        <p class="group-label mono">{t("section.education")}</p>
        <ul class="list">
          {education.map((e) => (
            <li>
              <span class="list-title">{tr(e.title)}</span>
              <span class="list-sub mono">{e.issuer} · {e.year}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="group-label mono">{t("section.certifications")}</p>
        <ul class="list">
          {certifications.map((c) => (
            <li>
              <span class="list-title">{tr(c.title)}</span>
              <span class="list-sub mono">{c.issuer} · {c.year}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="group-label mono">{t("section.languages")}</p>
        <ul class="list">
          {langList.map((l) => (
            <li>
              <span class="list-title">{l.label[lang]}</span>
              <span class="list-sub mono">{l.level[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: 1.75rem;
    max-width: var(--maxw-text);
  }
  .group-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-mute);
    margin-bottom: 0.75rem;
  }
  .group-label::before {
    content: "# ";
    color: var(--accent-dim);
  }

  .meta-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .list {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .list li {
    display: grid;
    gap: 0.2rem;
  }
  .list-title {
    font-size: 0.92rem;
    color: var(--text);
  }
  .list-sub {
    font-size: 0.76rem;
    color: var(--text-mute);
  }
</style>
