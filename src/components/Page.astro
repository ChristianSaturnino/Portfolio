---
import Base from "../layouts/Base.astro";
import TopBar from "./TopBar.astro";
import Hero from "./Hero.astro";
import Flagship from "./Flagship.astro";
import Selected from "./Selected.astro";
import About from "./About.astro";
import Career from "./Career.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../data/site";

// Home: one short page. Intro, the MarIA case, four projects, about me,
// career in a few lines. Everything else lives on its own page.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <TopBar lang={lang} page="home" />
  <main id="main">
    <Hero lang={lang} />
    <Flagship lang={lang} />
    <Selected lang={lang} />
    <About lang={lang} />
    <Career lang={lang} />
  </main>
  <Footer lang={lang} page="home" />
</Base>
