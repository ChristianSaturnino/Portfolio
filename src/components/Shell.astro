---
import Base from "../layouts/Base.astro";
import TopBar from "./TopBar.astro";
import Icon from "./Icon.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../data/site";
import type { Page } from "../i18n/ui";
import { useTranslations, homePath } from "../i18n/ui";

// Frame for the standalone pages (projects, stack, contact): the site header,
// one wide column and a title row with a back arrow to the home page.
interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  barTitle: string;
  barSub: string;
}
const { lang, page, title, description, barTitle, barSub } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={title} description={description}>
  <TopBar lang={lang} page={page} />
  <main id="main" class="column">
    <div class="pagebar">
      <a href={homePath(lang)} class="back" aria-label={t("stack.back")}>
        <Icon name="arrow" />
      </a>
      <div>
        <p class="tb-title display">{barTitle}</p>
        <p class="tb-sub">{barSub}</p>
      </div>
    </div>

    <slot />
  </main>
  <Footer lang={lang} page={page} />
</Base>

<style>
  .column {
    max-width: 940px;
    margin: 1rem auto 4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .pagebar {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .back {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    transition: background 0.15s ease;
  }
  .back:hover {
    background: var(--sunk);
  }
  .back :global(.icon) {
    transform: rotate(180deg);
  }
  .tb-title {
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .tb-sub {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  @media (max-width: 980px) {
    .column {
      margin: 0.5rem 1rem 3rem;
    }
  }
  @media (max-width: 700px) {
    .column {
      margin: 0 0 2rem;
      border-radius: 0;
      border-inline: 0;
    }
    .pagebar {
      padding: 0.4rem 1rem;
    }
  }
</style>
