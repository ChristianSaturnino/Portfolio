---
import type { Lang } from "../data/site";
import { projects } from "../data/projects";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="projects">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">02.</span>
      <h2>{t("section.projects")}</h2>
      <span class="rule"></span>
    </div>
    <p class="section-note reveal">{t("section.projectsNote")}</p>

    <div class="grid">
      {projects.map((p, i) => (
        <article class="card reveal" data-delay={String((i % 2) + 1)}>
          <span class="corner tl" aria-hidden="true"></span>
          <span class="corner br" aria-hidden="true"></span>

          <div class="card-top">
            <span class="num mono">PRJ_{String(i + 1).padStart(2, "0")}</span>
            <span class="kicker mono">{p.kicker[lang]}</span>
            {p.status && <span class="badge mono">{p.status[lang]}</span>}
          </div>

          <h3>{p.title[lang]}</h3>
          <p class="summary">{p.summary[lang]}</p>

          <p class="role">
            <span class="role-label mono">{t("projects.role")}</span>
            {p.contribution[lang]}
          </p>

          <div class="tag-row stack">
            {p.stack.map((s) => <span class="tag">{s}</span>)}
          </div>

          {p.links && p.links.length > 0 && (
            <div class="links">
              {p.links.map((l) => (
                <a class="link-underline mono" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .card:hover {
    border-color: var(--accent-dim);
    background: var(--bg-elev-2);
    transform: translateY(-3px);
    box-shadow: 0 14px 40px -18px var(--accent-glow);
  }

  /* corner brackets - drawn on hover */
  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    color: var(--accent);
  }
  .corner.tl {
    top: 7px;
    left: 7px;
    border-top: 1px solid currentColor;
    border-left: 1px solid currentColor;
  }
  .corner.br {
    bottom: 7px;
    right: 7px;
    border-bottom: 1px solid currentColor;
    border-right: 1px solid currentColor;
  }
  .card:hover .corner {
    opacity: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .num {
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .kicker {
    font-size: 0.72rem;
    color: var(--text-mute);
  }
  .badge {
    margin-left: auto;
    font-size: 0.66rem;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .summary {
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  .role {
    font-size: 0.86rem;
    color: var(--text-mute);
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }
  .role-label {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-mute);
    margin-bottom: 0.3rem;
  }
  .role-label::before {
    content: "$ ";
    color: var(--accent-dim);
  }

  .stack {
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .card:hover .tag {
    border-color: var(--border-strong);
  }

  .links {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
  }
</style>
