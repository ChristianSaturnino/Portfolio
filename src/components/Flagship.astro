---
import type { Lang } from "../data/site";
import { flagship } from "../data/flagship";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const nameHead = flagship.name.slice(0, flagship.name.length - flagship.nameAccent.length);
---

<section class="section flagship" id="flagship">
  <div class="container">
    <div class="panel reveal">
      <p class="eyebrow">{flagship.eyebrow[lang]}</p>

      <div class="head">
        <h2 class="name">{nameHead}<span class="accent">{flagship.nameAccent}</span></h2>
        <span class="at mono">@ {flagship.at}</span>
        <span class="status mono">{flagship.status[lang]}</span>
      </div>

      <p class="tagline">{flagship.tagline[lang]}</p>
      <p class="body prose">{flagship.body[lang]}</p>

      <div class="flow mono" aria-hidden="true">
        {flagship.flow[lang].map((step, i) => (
          <span class="node">
            {i > 0 && <span class="arrow">→</span>}
            <span class="step">{step}</span>
          </span>
        ))}
      </div>

      <dl class="facts">
        {flagship.facts.map((f) => (
          <div>
            <dt class="mono">{f.k[lang]}</dt>
            <dd>{f.v[lang]}</dd>
          </div>
        ))}
      </dl>

      <div class="tag-row stack">
        {flagship.stack.map((s) => <span class="tag">{s}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .flagship .panel {
    border: 1px solid var(--border-strong);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--accent-glow), transparent 32%), var(--bg-elev);
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.85rem 0 1.1rem;
  }
  .name {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .name .accent {
    color: var(--accent);
  }
  .at {
    font-size: 0.85rem;
    color: var(--text-mute);
  }
  .status {
    margin-left: auto;
    align-self: center;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
  }

  .tagline {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 500;
    color: var(--text);
    max-width: 42ch;
    margin-bottom: 1.15rem;
  }
  .body {
    font-size: 1rem;
  }

  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.76rem;
    color: var(--text-dim);
    margin: 1.6rem 0;
    padding: 1rem 0;
    border-block: 1px solid var(--border);
  }
  .flow .node {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .flow .arrow {
    color: var(--accent);
  }
  .flow .step {
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    padding: 0.3rem 0.55rem;
    background: var(--bg-elev-2);
    white-space: nowrap;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: 1.35rem;
    margin: 1.6rem 0;
  }
  .facts dt {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-mute);
    margin-bottom: 0.35rem;
  }
  .facts dt::before {
    content: "# ";
    color: var(--accent-dim);
  }
  .facts dd {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .stack {
    margin-top: 1.4rem;
  }

  @media (max-width: 560px) {
    .status {
      margin-left: 0;
    }
  }
</style>
