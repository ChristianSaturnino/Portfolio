---
import type { Lang } from "../data/site";
import { experience } from "../data/experience";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="experience">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index">01.</span>
      <h2>{t("section.experience")}</h2>
      <span class="rule"></span>
    </div>

    <ol class="timeline">
      {experience.map((job, i) => (
        <li class="entry reveal" data-delay={i === 0 ? "0" : "1"}>
          <div class="entry-head">
            <h3>{job.role[lang]}</h3>
            <span class="meta mono">
              {job.url ? <a class="link-underline" href={job.url} target="_blank" rel="noopener">{job.company}</a> : job.company}
              <span class="dot-sep" aria-hidden="true">/</span>
              {job.period[lang]}
            </span>
          </div>

          <ul class="bullets">
            {job.bullets[lang].map((b) => <li>{b}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    display: grid;
    gap: 3rem;
    max-width: var(--maxw-text);
  }

  .entry {
    position: relative;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border-strong);
  }
  .entry::before {
    content: "";
    position: absolute;
    left: -4.5px;
    top: 0.55rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }
  .entry:not(:first-child)::before {
    background: var(--border-strong);
    box-shadow: none;
  }

  .entry-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.9rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .meta {
    font-size: 0.8rem;
    color: var(--text-mute);
  }
  .dot-sep {
    margin-inline: 0.5rem;
    color: var(--accent-dim);
  }

  .bullets {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.96rem;
  }
  .bullets li {
    position: relative;
    padding-left: 1.1rem;
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 1px;
    background: var(--text-mute);
  }

</style>
