---
import { site, type Lang } from "../data/site";
import { useTranslations, homePath } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "pt" ? "en" : "pt";

const links = [
  { href: "#flagship", label: t("nav.flagship"), n: "01" },
  { href: "#experience", label: t("nav.experience"), n: "02" },
  { href: "#projects", label: t("nav.projects"), n: "03" },
  { href: "#skills", label: t("nav.skills"), n: "04" },
  { href: "#contact", label: t("nav.contact"), n: "05" },
];
---

<header data-header>
  <div class="container bar">
    <a href={homePath(lang)} class="brand mono" aria-label={site.name}>
      <span class="brand-mark">CS</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label={lang === "pt" ? "Navegação" : "Navigation"} data-spy>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="n mono">{l.n}</span>{l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="lang mono" href={homePath(other)} hreflang={other} aria-label={t("lang.switchLabel")}>
      <span aria-hidden="true">{lang.toUpperCase()}</span>
      <span class="lang-sep" aria-hidden="true">/</span>
      <span class="lang-next">{other.toUpperCase()}</span>
    </a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  header[data-scrolled] {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text);
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .brand:hover .brand-mark {
    border-color: var(--accent-dim);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 1.3rem;
    list-style: none;
  }
  nav a {
    font-size: 0.9rem;
    color: var(--text-dim);
    white-space: nowrap;
    transition: color 0.18s ease;
  }
  nav a .n {
    font-size: 0.68rem;
    color: var(--text-mute);
    margin-right: 0.45rem;
    transition: color 0.18s ease, opacity 0.18s ease;
    opacity: 0.65;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a:hover .n,
  nav a[data-active] .n {
    color: var(--accent);
    opacity: 1;
  }
  nav a[data-active] {
    color: var(--text);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-mute);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .lang:hover {
    border-color: var(--border-strong);
    color: var(--text-dim);
  }
  .lang-next {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .bar {
      gap: 1rem;
    }
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 680px) {
    nav {
      display: none;
    }
    .lang {
      margin-left: auto;
    }
  }
</style>
